{
  "compilerOptions": {
    "module": "NodeNext",
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "rootDir": ".",
    "sourceMap": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "target": "es2017",
    "lib": ["es2017"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "compileOnSave": true,
  "include": ["src"]
}
